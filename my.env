# индивидуальные настройки

GITHUB_RAW_IP=185.199.108.133

# Данные для для сертификатов
AZ_DOMAIN=
AZ_EMAIL=

# Настройки авторизации сервисов wg, ovpn-ui, ocserv, dash
AZ_USER=admin
AZ_PASS=strongpassword

# Proxy config
PROXY_LOGIN=
PROXY_PASSWORD=

# Wireguard conf
WG_MTU=1280
BGP_ENABLE=true

# Ocserv conf
OC_PORT=443
OC_SECRET=kvn

# Маршруты IP
IPS_URL=https://xtrime-ru.github.io/antizapret-vpn-docker/lists/ips.txt
IPS_WORLD_URL=https://xtrime-ru.github.io/antizapret-vpn-docker/lists/ips-world.txt
ASN_URL=https://xtrime-ru.github.io/antizapret-vpn-docker/lists/asn.txt
ASN_WORLD_URL=https://xtrime-ru.github.io/antizapret-vpn-docker/lists/asn-world.txt

########## RISK ##########
# Внутренние подсети
ROUTES="
  ocserv:10.1.164.0/24;
  openvpn:10.1.165.0/24;
  wireguard:10.1.166.0/24;
  wireguard-amnezia:10.1.167.0/24;
  adguard:14.16.0.1;
  az-local:14.16.0.0/15;
  az-world:14.18.0.0/15;"

# docker network
DOCKER_MTU=1500
DOCKER_ENC="true"

# AZ
IPTABLES_SAVE_DISABLED=0
